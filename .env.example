# API configuration
# Lyrics APIs are public and don't require keys.
# Music metadata APIs (Deezer, iTunes, Last.fm) are also public for basic usage.

# Optional: Last.fm API key (free registration at last.fm)
VITE_LASTFM_API_KEY=

# Optional: AudD music recognition API key (free tier at audd.io)
# Without this, song detection runs in demo mode and returns a sample song.
VITE_AUDD_API_KEY=

# Optional: proxy base for CORS-free API access
# VITE_API_PROXY=
